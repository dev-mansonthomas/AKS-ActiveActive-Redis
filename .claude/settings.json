{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(shellcheck:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format --check:*)",
      "Bash(python3 -m py_compile:*)",
      "Bash(tofu fmt:*)",
      "Bash(tofu validate:*)",
      "Bash(tofu init -backend=false:*)",
      "Bash(tofu version)",
      "Bash(tofu providers)",
      "Bash(git ls-files:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-list:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(ast-grep:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(diff:*)",
      "Bash(comm:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(kubectl --help:*)",
      "Bash(helm template:*)",
      "Bash(helm lint:*)",
      "Bash(redis-cli --version)"
    ],
    "deny": [
      "Bash(tofu apply:*)",
      "Bash(tofu destroy:*)",
      "Bash(tofu plan:*)",
      "Bash(tofu import:*)",
      "Bash(tofu state:*)",
      "Bash(az:*)",
      "Bash(aws:*)",
      "Bash(gcloud:*)",
      "Bash(gsutil:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl create:*)",
      "Bash(kubectl patch:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl drain:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm uninstall:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(./create-all.sh)",
      "Bash(./delete-all-resources.sh)",
      "Bash(./recreate.sh)",
      "Bash(./chaos.sh)",
      "Bash(./01-create-cluster.sh)",
      "Bash(docker push:*)",
      "Read(**/.terraform/**)",
      "Read(**/terraform.tfstate*)"
    ]
  }
}
